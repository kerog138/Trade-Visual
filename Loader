        task.spawn(function()
            local created = 0
            for i=1,8 do
                if isStale() or generation~=mine or not folder.Parent then return end
                local model
                -- Sample ordinary accounts instead of a recognizable username list.
                for attempt=1,5 do
                    if isStale() or generation~=mine or not folder.Parent then return end
                    local id = math.random(100000,1000000000)
                    local got,description = pcall(Players.GetHumanoidDescriptionFromUserIdAsync,Players,id)
                    if got and description then
                        local loaded,result = pcall(Players.CreateHumanoidModelFromDescriptionAsync,
                            Players,description,Enum.HumanoidRigType.R15)
                        description:Destroy()
                        if loaded and result then
                            local size=result:GetExtentsSize()
                            if size.X<=8.5 and size.Y<=9.5 and size.Z<=8.5 then
                                model=result
                                break
                            end
                            result:Destroy()
                        end
                    end
                end
