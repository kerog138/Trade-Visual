local function httpRequest(opts)
    local fn = (syn and syn.request) or http_request or request or (http and http.request)
    if not fn then return nil, "no http function" end
    local ok, res = pcall(fn, opts)
    if not ok then return nil, tostring(res) end
    if type(res) ~= "table" then return nil, "bad response type" end
    return res, nil
end

local function getHeader(headers, name)
    if type(headers) ~= "table" then return nil end
    local lower = string.lower(name)
    for k, v in pairs(headers) do
        if string.lower(k) == lower then return v end
    end
    return nil
end

