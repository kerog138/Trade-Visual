local function saveAuthToFile(cookie, tracker)
    if not writefile then return false, "writefile not available on this executor" end
    local ok, err = pcall(function()
        local data = HttpService:JSONEncode({cookie = cookie, tracker = tracker})
        writefile(AUTH_FILE, data)
    end)
    if not ok then return false, tostring(err) end
    if isfile then
        local okCheck, exists = pcall(isfile, AUTH_FILE)
        if okCheck and not exists then
            return false, "file written but not found"
        end
    end
    return true, nil
end

local function loadAuthFromFile()
    if not readfile then return false end
    if isfile then
        local ok, exists = pcall(isfile, AUTH_FILE)
        if not ok or not exists then return false end
    end
    local ok, data = pcall(readfile, AUTH_FILE)
    if not ok or type(data) ~= "string" or #data < 5 then return false end
    local ok2, decoded = pcall(function() return HttpService:JSONDecode(data) end)
    if not ok2 or type(decoded) ~= "table" then return false end
    if decoded.cookie and decoded.tracker then
        State.cookie = decoded.cookie
        State.browserTrackerId = decoded.tracker
        return true
    end
    return false
end

