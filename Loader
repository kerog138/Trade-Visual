local CHROMA_SUFFIX_PATTERN = "%s*[Cc]hroma%s*$"
local function StripChromaSuffix(name)
    if type(name) ~= "string" then return name end
    local stripped = string.gsub(name, CHROMA_SUFFIX_PATTERN, "")
    if stripped == "" then return name end
    return stripped
end

