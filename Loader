local function ScannerFormatNum(n)
    local s = tostring(math.floor(n))
    local out, len = "", #s
    for i = 1, len do
        if i > 1 and (len - i + 1) % 3 == 0 then out = out .. "," end
        out = out .. s:sub(i, i)
    end
    return out
end

