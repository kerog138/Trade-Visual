                                textLabel.TextStrokeTransparency=0.2
                                textLabel.Text=name
                                textLabel.Parent=plate
                            end
                        end
                        local setWalking,playJump=animate(humanoid,animationPacks[(styleIndex-1)%#animationPacks+1])
                        local floorOffset=model:GetAttribute("FloorOffset")
                        local lastRecovery=-math.huge
                        local function active()
                            return not isStale() and generation==mine and model.Parent==folder
                        end
                        local function flatDistance(a,b)
                            return (Vector3.new(a.X,0,a.Z)-Vector3.new(b.X,0,b.Z)).Magnitude
                        end
                        local function collisionParams(character)
                            local ignored={folder}
                            if character then ignored[#ignored+1]=character end
                            local cast=RaycastParams.new()
                            cast.FilterType=Enum.RaycastFilterType.Exclude
                            cast.FilterDescendantsInstances=ignored
                            cast.RespectCanCollide=true
                            local overlap=OverlapParams.new()
                            overlap.FilterType=Enum.RaycastFilterType.Exclude
                            overlap.FilterDescendantsInstances=ignored
                            overlap.RespectCanCollide=true
                            return cast,overlap
                        end
                        local function recoverFromObstacle(character)
                            if os.clock()-lastRecovery<7 or not active() then return false end
                            local cast,overlap=collisionParams(character)
                            local start=root.Position
                            -- A wall or ceiling above the avatar cannot be cleared with a hop.
                            if #Workspace:GetPartBoundsInBox(CFrame.new(start+Vector3.new(0,2.7,0)),
                                Vector3.new(1.8,2.2,1.8),overlap)>0 then return false end
                            local landing=start
                            local floorY=start.Y-floorOffset
                            for attempt=1,8 do
                                local candidate,floorPart=groundNear(start,3+math.random()*2,floorY)
                                if candidate and hasRoomAt(candidate,floorPart) then
                                    local nextPosition=Vector3.new(candidate.X,candidate.Y+floorOffset,candidate.Z)
                                    local sweep=Workspace:Blockcast(CFrame.new(start+Vector3.new(0,2.7,0)),
                                        Vector3.new(1.8,2.2,1.8),nextPosition-start,cast)
                                    if not sweep then landing=nextPosition; break end
                                end
                            end
                            lastRecovery=os.clock()
                            setWalking(false)
                            playJump()
                            local facing=landing-start
                            facing=Vector3.new(facing.X,0,facing.Z)
                            facing=facing.Magnitude>0.1 and facing.Unit or root.CFrame.LookVector
                            local begun=os.clock()
                            repeat
                                RunService.PreSimulation:Wait()
                                if not active() then return false end
                                local alpha=math.clamp((os.clock()-begun)/0.7,0,1)
                                local position=start:Lerp(landing,alpha)+Vector3.new(0,math.sin(alpha*math.pi)*2.7,0)
                                root.CFrame=CFrame.lookAt(position,position+facing)
                            until os.clock()-begun>=0.7
                            root.CFrame=CFrame.lookAt(landing,landing+facing)
                            return true
                        end
                        local function walkSegment(target,jump,character,shouldReplan)
                            local start=root.Position
                            local direction=Vector3.new(target.X-start.X,0,target.Z-start.Z)
                            if direction.Magnitude<1.2 and math.abs(target.Y-start.Y)<0.8 then return true,false end
                            local facing=direction.Magnitude>0.1 and direction.Unit or root.CFrame.LookVector
                            local original=root.CFrame
                            local duration=math.clamp((target-start).Magnitude/7,0.35,3.5)
                            local cast=collisionParams(character)
                            local begun=os.clock()
                            setWalking(true)
                            if jump then playJump() end
                            repeat
                                RunService.PreSimulation:Wait()
                                if not active() then setWalking(false); return false,false end
                                if shouldReplan and shouldReplan() then
                                    setWalking(false)
                                    return false,false
                                end
                                local alpha=math.clamp((os.clock()-begun)/duration,0,1)
                                local eased=alpha*alpha*(3-2*alpha)
                                local position=start:Lerp(target,eased)
                                if jump then position=position+Vector3.new(0,math.sin(alpha*math.pi)*2.7,0) end
                                local movement=position-root.Position
                                if movement.Magnitude>0.01 then
                                    local hit=Workspace:Blockcast(CFrame.new(root.Position),
                                        Vector3.new(2.2,2.6,2.2),movement,cast)
                                    if hit then
                                        if jump then root.CFrame=original end
                                        setWalking(false)
                                        return false,true
                                    end
                                end
                                root.CFrame=CFrame.lookAt(position,position+facing)
                            until os.clock()-begun>=duration
                            setWalking(false)
                            return true,false
                        end
                        task.spawn(function()
                            while active() do
                                task.wait(1+math.random()*0.5)
                                if not active() then break end
                                local character=Players.LocalPlayer.Character
                                local playerRoot=character and character:FindFirstChild("HumanoidRootPart")
                                local _,overlap=collisionParams(character)
                                local embedded=#Workspace:GetPartsInPart(root,overlap)>0
                                if embedded then
                                    recoverFromObstacle(character)
                                    embedded=#Workspace:GetPartsInPart(root,overlap)>0
                                end
                                if not embedded and playerRoot and flatDistance(root.Position,playerRoot.Position)>10 then
                                    local playerGround=groundNear(playerRoot.Position,0)
                                    local goal
                                    if playerGround then
                                        for attempt=1,6 do
                                            local spot,floorPart=groundNear(playerRoot.Position,4+math.random()*3,playerGround.Y)
                                            if spot and hasRoomAt(spot,floorPart) then
                                                goal=Vector3.new(spot.X,spot.Y+floorOffset,spot.Z)
                                                break
                                            end
                                        end
                                    end
                                    if goal then
                                        local path=PathfindingService:CreatePath({
                                            AgentRadius=2,AgentHeight=5,AgentCanJump=true,WaypointSpacing=4,
                                        })
                                        local computed=pcall(path.ComputeAsync,path,root.Position,goal)
                                        if not active() then path:Destroy(); break end
                                        if computed and path.Status==Enum.PathStatus.Success then
                                            local waypoints=path:GetWaypoints()
                                            local waypointIndex=2
                                            local blocked=false
                                            local blockedConnection=path.Blocked:Connect(function(index)
                                                if index>=waypointIndex then blocked=true end
                                            end)
                                            local plannedPlayerPosition=playerRoot.Position
                                            for index=2,math.min(#waypoints,10) do
                                                if not active() or blocked then break end
                                                waypointIndex=index
                                                local liveRoot=character and character:FindFirstChild("HumanoidRootPart")
                                                if not liveRoot or flatDistance(root.Position,liveRoot.Position)<8
                                                    or flatDistance(plannedPlayerPosition,liveRoot.Position)>13 then break end
                                                local waypoint=waypoints[index]
                                                local ground=groundNear(waypoint.Position,0)
                                                if not ground then break end
                                                local target=Vector3.new(ground.X,ground.Y+floorOffset,ground.Z)
                                                local reached,obstructed=walkSegment(target,
                                                    waypoint.Action==Enum.PathWaypointAction.Jump,character,
                                                    function() return blocked end)
                                                if obstructed then recoverFromObstacle(character); break end
                                                if not reached then break end
                                            end
                                            blockedConnection:Disconnect()
                                        else
                                            local cast=collisionParams(character)
                                            local start=root.Position
                                            local toward=Vector3.new(goal.X-start.X,0,goal.Z-start.Z)
                                            if toward.Magnitude>0.1 then
                                                local step=start+toward.Unit*math.min(toward.Magnitude,9)
                                                local floor=groundNear(step,0,start.Y-floorOffset)
                                                if floor then
                                                    local target=Vector3.new(floor.X,floor.Y+floorOffset,floor.Z)
                                                    local movement=target-start
                                                    if not Workspace:Blockcast(CFrame.new(start),
                                                        Vector3.new(2.2,2.6,2.2),movement,cast) then
                                                        local _,obstructed=walkSegment(target,false,character)
                                                        if obstructed then recoverFromObstacle(character) end
                                                    end
                                                end
                                            end
                                        end
                                        path:Destroy()
                                    end
                                elseif not embedded and math.random()<0.08 then
                                    local floorY=root.Position.Y-floorOffset
                                    local ground=groundNear(root.Position,2+math.random()*2,floorY)
                                    if ground then
                                        local target=Vector3.new(ground.X,ground.Y+floorOffset,ground.Z)
                                        local _,obstructed=walkSegment(target,false,character)
                                        if obstructed then recoverFromObstacle(character) end
                                    end
                                end
                            end
                        end)
                    else
                        model:Destroy()
                    end
                end
                return model.Parent==folder
    end
