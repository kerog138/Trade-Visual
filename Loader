local function pixels(encoded, width, height)
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup = {}
    for i = 1, #alphabet do lookup[alphabet:byte(i)] = i - 1 end
    local result = buffer.create(width * height * 4)
    local offset = 0
    for i = 1, #encoded, 4 do
        local a,b,c,d = encoded:byte(i,i+3)
        a,b = lookup[a],lookup[b]
        buffer.writeu8(result,offset,a*4+math.floor(b/16)); offset += 1
        if c ~= 61 then
            c = lookup[c]
            buffer.writeu8(result,offset,(b%16)*16+math.floor(c/4)); offset += 1
            if d ~= 61 then
                buffer.writeu8(result,offset,(c%4)*64+lookup[d]); offset += 1
            end
        end
    end
    assert(offset == buffer.len(result))
    return result
end
local function make(class, parent, props)
    local item = Instance.new(class)
    for k,v in pairs(props) do item[k] = v end
    item.Parent = parent
    return item
end
local function fade(item, seconds, props)
    local t = TweenService:Create(item,TweenInfo.new(seconds,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),props)
