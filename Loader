    local function groundNear(center, distance, referenceY)
        local angle = math.random()*math.pi*2
        local point = center+Vector3.new(math.cos(angle)*distance,0,math.sin(angle)*distance)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.RespectCanCollide = true
        local ignored = {}
        if lifecycle.fakeLobbyFolder then ignored[#ignored+1] = lifecycle.fakeLobbyFolder end
        if Players.LocalPlayer.Character then ignored[#ignored+1] = Players.LocalPlayer.Character end
        params.FilterDescendantsInstances = ignored
        -- Start close to the current floor so a roof or platform above the lobby is not chosen.
        local height = referenceY or center.Y
        local hit = Workspace:Raycast(Vector3.new(point.X,height+5,point.Z),Vector3.new(0,-15,0),params)
        if not hit or (referenceY and math.abs(hit.Position.Y-referenceY)>1.5) then return nil end
        return hit.Position,hit.Instance
    end
    local function hasRoomAt(point,floorPart)
        local params=OverlapParams.new()
        params.FilterType=Enum.RaycastFilterType.Exclude
        params.RespectCanCollide=true
        local ignored={}
        if lifecycle.fakeLobbyFolder then ignored[#ignored+1]=lifecycle.fakeLobbyFolder end
        if Players.LocalPlayer.Character then ignored[#ignored+1]=Players.LocalPlayer.Character end
        if floorPart and floorPart:IsA("BasePart") then
            ignored[#ignored+1]=floorPart
        end
        params.FilterDescendantsInstances=ignored
        return #Workspace:GetPartBoundsInBox(CFrame.new(point+Vector3.new(0,2.35,0)),
            Vector3.new(2.4,4.4,2.4),params)==0
    end
