local function createSettingRow(labelText, defaultValue, parent, masked)
    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1; row.Size = UDim2.new(1,0,0,0); row.AutomaticSize = Enum.AutomaticSize.Y; row.Parent = parent
    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Vertical; layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.Padding = UDim.new(0,4); layout.Parent = row
    local heading = Instance.new("TextLabel")
    functions.styleFlowText(heading)
    heading.Size = UDim2.new(1,0,0,0); heading.LayoutOrder = 1; heading.BackgroundTransparency = 1
    heading.Text = labelText; heading.Font = Enum.Font.GothamBold; heading.TextSize = 14
    heading.TextColor3 = THEME.Muted; heading.TextXAlignment = Enum.TextXAlignment.Left; heading.Parent = row
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1,0,0,34); box.LayoutOrder = 2; box.AutomaticSize = Enum.AutomaticSize.None; box.BackgroundColor3 = THEME.Panel2; box.BackgroundTransparency = 0.08
    box.Text = defaultValue or ""; box.Font = Enum.Font.GothamBold; box.TextSize = 14
    box.TextColor3 = THEME.Text; box.PlaceholderColor3 = THEME.Muted
    if masked then box.TextTransparency = 1 end
    box.ClearTextOnFocus = false; box.TextXAlignment = Enum.TextXAlignment.Left; box.Parent = row
    box.TextWrapped = false
    box.MultiLine = false
    box.ClipsDescendants = true
    Instance.new("UICorner",box).CornerRadius = UDim.new(0,7)
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 8)
    pad.PaddingRight = UDim.new(0, 8)
    pad.Parent = box
    if masked then
        -- The actual value stays in the TextBox; only stars are rendered.
        local view = Instance.new("ScrollingFrame")
        view.Name = "AuthScroll"
        view.BackgroundTransparency = 1
        view.BorderSizePixel = 0
        view.Size = UDim2.new(1,0,1,0)
        view.CanvasSize = UDim2.fromOffset(0,0)
        view.ScrollingDirection = Enum.ScrollingDirection.X
        view.ScrollBarThickness = 4
        view.ScrollBarImageColor3 = THEME.Purple
        view.ElasticBehavior = Enum.ElasticBehavior.Never
        view.ClipsDescendants = true
        view.Active = true
        view.ZIndex = box.ZIndex + 1
        view.Parent = box

        local mask = Instance.new("TextLabel")
        mask.Name = "AuthMask"
        mask.BackgroundTransparency = 1
        mask.Font = Enum.Font.Code
        mask.TextSize = box.TextSize
        mask.TextColor3 = box.TextColor3
        mask.TextXAlignment = Enum.TextXAlignment.Left
        mask.TextYAlignment = Enum.TextYAlignment.Center
        mask.TextTruncate = Enum.TextTruncate.None
        mask.TextWrapped = false
        mask.ZIndex = view.ZIndex + 1
        mask.Parent = view

        local selection = Instance.new("Frame")
        selection.Name = "AuthSelection"
        selection.BorderSizePixel = 0
        selection.BackgroundColor3 = THEME.Purple
        selection.BackgroundTransparency = 0.55
        selection.ZIndex = view.ZIndex
        selection.Parent = view

        local caret = Instance.new("Frame")
        caret.Name = "AuthCaret"
        caret.BorderSizePixel = 0
        caret.BackgroundColor3 = THEME.Text
        caret.Size = UDim2.fromOffset(1,18)
        caret.ZIndex = mask.ZIndex + 1
        caret.Visible = false
        caret.Parent = view

        local advance = game:GetService("TextService"):GetTextSize(
            "*", box.TextSize, mask.Font, Vector2.new(100,100)).X
        local blinkStarted = os.clock()
        local function refreshMask(followCursor)
            local length = #box.Text
            local width = math.max(1, view.AbsoluteSize.X)
            local contentWidth = math.max(width, length * advance + 6)
            mask.Text = string.rep("*", length)
            mask.Size = UDim2.fromOffset(contentWidth,30)
            view.CanvasSize = UDim2.fromOffset(contentWidth,0)
            local cursor = math.clamp(box.CursorPosition - 1, 0, length)
            local x = cursor * advance
            caret.Position = UDim2.fromOffset(x,6)
            if followCursor and box:IsFocused() then
                local offset = view.CanvasPosition.X
                if x < offset + 2 then offset = x - 2 end
                if x > offset + width - 6 then offset = x - width + 6 end
                view.CanvasPosition = Vector2.new(math.clamp(offset,0,math.max(0,contentWidth-width)),0)
                blinkStarted = os.clock()
            end
            local anchor = box.SelectionStart
            selection.Visible = box:IsFocused() and anchor > 0 and anchor ~= box.CursorPosition
            if selection.Visible then
                local other = math.clamp(anchor - 1,0,length)
                selection.Position = UDim2.fromOffset(math.min(cursor,other)*advance,6)
                selection.Size = UDim2.fromOffset(math.abs(cursor-other)*advance,18)
            end
            caret.Visible = box:IsFocused()
        end
        local function connect(signal, callback)
            table.insert(externalConnections, signal:Connect(callback))
        end
        connect(box:GetPropertyChangedSignal("Text"), function() refreshMask(true) end)
        connect(box:GetPropertyChangedSignal("CursorPosition"), function() refreshMask(true) end)
        connect(box:GetPropertyChangedSignal("SelectionStart"), function() refreshMask(false) end)
        connect(view:GetPropertyChangedSignal("AbsoluteSize"), function() refreshMask(true) end)
        connect(box.Focused, function() blinkStarted = os.clock(); refreshMask(true) end)
        connect(box.FocusLost, function() caret.Visible = false; selection.Visible = false end)
        -- Map taps to stars instead of the invisible, variable-width secret text.
        local pointerStart
        connect(view.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                pointerStart = input.Position
            end
        end)
        connect(view.InputEnded, function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then return end
            local start = pointerStart
            pointerStart = nil
            if not start or (input.Position-start).Magnitude > 6 then return end
            if input.Position.Y-view.AbsolutePosition.Y >= view.AbsoluteSize.Y-6 then return end
            local x = input.Position.X-view.AbsolutePosition.X+view.CanvasPosition.X
            local position = math.clamp(math.floor(x/advance+0.5)+1,1,#box.Text+1)
            box:CaptureFocus()
            task.defer(function()
                if not box.Parent or not box:IsFocused() then return end
                box.SelectionStart = -1
                box.CursorPosition = position
                refreshMask(true)
            end)
        end)
        connect(game:GetService("RunService").RenderStepped, function()
            caret.Visible = box:IsFocused() and (os.clock()-blinkStarted)%1 < 0.5
        end)
        refreshMask(false)
    end
    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = THEME.PurpleDark; stroke.Thickness = 1; stroke.Transparency = 0.35; stroke.Parent = box
    box.Focused:Connect(function()
        TweenService:Create(stroke,TweenInfo.new(0.15),{Color=THEME.Purple,Thickness=1.2,Transparency=0.15}):Play()
    end)
    box.FocusLost:Connect(function()
        TweenService:Create(stroke,TweenInfo.new(0.15),{Color=THEME.PurpleDark,Thickness=1,Transparency=0.35}):Play()
    end)
    return box
end

