local AUTH_FOLDER = "MM2-Blessing"
local COOKIE_FILE = AUTH_FOLDER .. "/cookie.txt"
local TRACKER_FILE = AUTH_FOLDER .. "/Rbxtrackerid.txt"
local LEGACY_AUTH_FILE = "visualtrade_auth.json"

-- Reversible obfuscation for casual viewing; this is not encryption.
local AUTH_SYMBOLS = "@#%&*!?+=:;~^()_"
local function encodeAuth(value)
    local salt = math.random(0, 255)
    local encoded = {}
    local function appendByte(byte)
        local high = math.floor(byte / 16) + 1
        local low = byte % 16 + 1
        encoded[#encoded + 1] = AUTH_SYMBOLS:sub(high, high)
        encoded[#encoded + 1] = AUTH_SYMBOLS:sub(low, low)
    end
    appendByte(salt)
    for i = 1, #value do
        appendByte((value:byte(i) + salt + i * 37) % 256)
    end
    return "-- Encrypted by MM2 Blessing, fully unreadable only script can read this\n" .. table.concat(encoded)
end

local function decodeAuth(encoded)
    if type(encoded) ~= "string" then return nil end
    local header = "-- Encrypted by MM2 Blessing, fully unreadable only script can read this"
    if encoded:sub(1, #header) == header then
        encoded = encoded:sub(#header + 1)
        if encoded:sub(1, 2) == "\r\n" then
            encoded = encoded:sub(3)
        elseif encoded:sub(1, 1) == "\n" then
            encoded = encoded:sub(2)
        else
            return nil
        end
    end
    if type(encoded) ~= "string" or #encoded < 2 or #encoded % 2 ~= 0 then
        return nil
    end
    local bytes = {}
    for i = 1, #encoded, 2 do
        local high = AUTH_SYMBOLS:find(encoded:sub(i, i), 1, true)
        local low = AUTH_SYMBOLS:find(encoded:sub(i + 1, i + 1), 1, true)
        if not high or not low then return nil end
        bytes[#bytes + 1] = (high - 1) * 16 + low - 1
    end
    local salt = bytes[1]
    local decoded = {}
    for i = 2, #bytes do
        decoded[#decoded + 1] = string.char((bytes[i] - salt - (i - 1) * 37) % 256)
    end
    return table.concat(decoded)
end

local function saveAuthToFile(cookie, tracker)
    if not writefile then return false, "writefile not available on this executor" end
    local ok, err = pcall(function()
        if isfolder then
            if not isfolder(AUTH_FOLDER) then
                assert(makefolder, "makefolder not available on this executor")
                makefolder(AUTH_FOLDER)
            end
        elseif makefolder then
            pcall(makefolder, AUTH_FOLDER)
        end
        local cookieData, trackerData = encodeAuth(cookie), encodeAuth(tracker)
        writefile(COOKIE_FILE, cookieData)
        writefile(TRACKER_FILE, trackerData)
        if readfile then
            assert(readfile(COOKIE_FILE) == cookieData, "cookie file verification failed")
            assert(readfile(TRACKER_FILE) == trackerData, "tracker file verification failed")
        elseif isfile then
            assert(isfile(COOKIE_FILE) and isfile(TRACKER_FILE), "file written but not found")
        end
    end)
    if not ok then return false, tostring(err) end
    -- Remove the previous plaintext copy only after the new save succeeds.
    if delfile then pcall(delfile, LEGACY_AUTH_FILE) end
    return true, nil
end

local function loadAuthFromFile()
    if not readfile then return false end
    local cookieOk, cookieData = pcall(readfile, COOKIE_FILE)
    local trackerOk, trackerData = pcall(readfile, TRACKER_FILE)
    if cookieOk and trackerOk then
        local cookie, tracker = decodeAuth(cookieData), decodeAuth(trackerData)
        if cookie and tracker then
            State.cookie = cookie
            State.browserTrackerId = tracker
            return true
        end
    end
    -- Preserve existing saved auth by migrating the original JSON file.
    local ok, data = pcall(readfile, LEGACY_AUTH_FILE)
    if not ok or type(data) ~= "string" then return false end
    local decodedOk, decoded = pcall(function() return HttpService:JSONDecode(data) end)
    if not decodedOk or type(decoded) ~= "table" then return false end
    if type(decoded.cookie) ~= "string" or type(decoded.tracker) ~= "string" then return false end
    State.cookie = decoded.cookie
    State.browserTrackerId = decoded.tracker
    local saved, err = saveAuthToFile(decoded.cookie, decoded.tracker)
    if not saved then warn("[VisualTrade] Auth file migration failed: " .. tostring(err)) end
    return true
end

local function clearAuthFile()
    if not delfile then return end
    pcall(delfile, COOKIE_FILE)
    pcall(delfile, TRACKER_FILE)
    pcall(delfile, LEGACY_AUTH_FILE)
end

