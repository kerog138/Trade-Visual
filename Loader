    local function animate(humanoid,pack)
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if not animator then animator=Instance.new("Animator"); animator.Parent=humanoid end
        local function load(assetId,priority)
            local animation=Instance.new("Animation")
            animation.AnimationId="rbxassetid://"..assetId
            local ok,track=pcall(animator.LoadAnimation,animator,animation)
            animation:Destroy()
            if not ok then return nil end
            track.Priority=priority
            track.Looped=true
            return track
        end
        local idle=load(pack.idle,Enum.AnimationPriority.Idle)
        local walk=load(pack.walk,Enum.AnimationPriority.Movement)
        local jump=load(pack.jump,Enum.AnimationPriority.Action)
        if jump then jump.Looped=false end
        if idle then idle:Play(0.15) end
        local function setWalking(active)
            if active then
                if idle and idle.IsPlaying then idle:Stop(0.18) end
                if walk and not walk.IsPlaying then walk:Play(0.18) end
                if walk then walk:AdjustSpeed(0.85+math.random()*0.25) end
            else
                if walk and walk.IsPlaying then walk:Stop(0.2) end
                if idle and not idle.IsPlaying then idle:Play(0.2) end
            end
        end
        local function playJump()
            if jump then jump:Play(0.1) end
        end
        return setWalking,playJump
    end
    local function placeModel(model,name,folder,mine,styleIndex,showNameplate)
                if model then
