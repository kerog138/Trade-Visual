local function hookOwned(itemType, ownedTable)
    if type(ownedTable) ~= "table" then return end
    if not trueValues[itemType] then trueValues[itemType] = {} end
    if savedOwnedMetatables[ownedTable] == nil then
        savedOwnedMetatables[ownedTable] = { mt = getmetatable(ownedTable) }
    end
    
    for k, v in pairs(ownedTable) do
        if trueValues[itemType][k] == nil then
            trueValues[itemType][k] = v
        end
    end
    
    local mt = getmetatable(ownedTable) or {}
    local oldNewIndex = mt.__newindex
    mt.__newindex = function(t, k, v)
        if not trueValues[itemType] then trueValues[itemType] = {} end
        local sp = spoofed[itemType] and spoofed[itemType][k] or 0
        local currDisplay = rawget(t, k) or 0
        local currTrue = trueValues[itemType][k] or 0
        local newTrue = currTrue + (v - currDisplay)
        if newTrue < 0 then newTrue = 0 end
        trueValues[itemType][k] = newTrue
        if oldNewIndex then oldNewIndex(t, k, newTrue + sp) else rawset(t, k, newTrue + sp) end
    end
    setmetatable(ownedTable, mt)
end

local function applySpoofs(itemType, ownedTable)
    if type(ownedTable) ~= "table" then return end
    if not trueValues[itemType] then trueValues[itemType] = {} end
    if not spoofed[itemType] then spoofed[itemType] = {} end
    
    for k in pairs(ownedTable) do
        if trueValues[itemType][k] == nil then
            rawset(ownedTable, k, nil)
        end
    end
    for k, v in pairs(trueValues[itemType]) do
        rawset(ownedTable, k, v)
    end
    for k, v in pairs(spoofed[itemType]) do
        rawset(ownedTable, k, (trueValues[itemType][k] or 0) + v)
    end
end

for itemType, data in pairs(ProfileData) do
    if type(data) == "table" then
        trueValues[itemType] = trueValues[itemType] or {}
        spoofed[itemType] = spoofed[itemType] or {}
        
        if savedMetatables[data] == nil then
            savedMetatables[data] = { mt = getmetatable(data) }
        end
        local currentOwned = data.Owned
        if type(currentOwned) ~= "table" then currentOwned = {} end
        data.Owned = nil
        
        for k, raw in pairs(currentOwned) do
            if type(raw) == "number" then
                local expected = (trueValues[itemType][k] or 0) + (spoofed[itemType][k] or 0)
                if raw ~= expected then
                    trueValues[itemType][k] = raw
                    spoofed[itemType][k] = 0
                end
            end
        end
        
        hookOwned(itemType, currentOwned)
        
        local mt = getmetatable(data) or {}
        local oldIndex = mt.__index
        local oldNewIndex = mt.__newindex
        
        mt.__index = function(t, k)
            if k == "Owned" then return currentOwned end
            if oldIndex then return oldIndex(t, k) end
            return rawget(t, k)
        end
        
        mt.__newindex = function(t, k, v)
            if k == "Owned" then
                if type(v) ~= "table" then v = {} end
                currentOwned = v
                trueValues[itemType] = {}
                spoofed[itemType] = spoofed[itemType] or {}
                hookOwned(itemType, currentOwned)
                applySpoofs(itemType, currentOwned)
            else
                if oldNewIndex then oldNewIndex(t, k, v) else rawset(t, k, v) end
            end
        end
        setmetatable(data, mt)
    end
end

