                    local loaded,result = pcall(Players.CreateHumanoidModelFromDescriptionAsync,
                        Players,desc,Enum.HumanoidRigType.R15)
                    desc:Destroy()
                    if loaded then model=result end
                end
                local name = firstNames[math.random(#firstNames)]..
                    suffixes[math.random(#suffixes)]..tostring(math.random(10,999))
                if model and placeModel(model,name,folder,mine,i) then created=created+1 end
