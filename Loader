local function CreateButton(f, text, fn, colorOverride)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,0,0,36)
    btn.BackgroundColor3 = colorOverride or THEME.Panel2
    btn.BackgroundTransparency = 0.12
    btn.Text = text; btn.Font = Enum.Font.GothamBold; btn.TextSize = 14
    btn.TextColor3 = THEME.Text; btn.AutoButtonColor = false; btn.Parent = f
    Instance.new("UICorner",btn).CornerRadius = UDim.new(0,8)
    local st = Instance.new("UIStroke")
    st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    st.Color = THEME.PurpleDark; st.Thickness = 1; st.Transparency = 0.25; st.Parent = btn
    local hovered, colorTween = false, nil
    local function baseColor()
        if btn:GetAttribute("ToggleActive") then return THEME.Success end
        return hovered and THEME.PurpleDark or colorOverride or THEME.Panel2
    end
    local function paint(duration)
        if colorTween then colorTween:Cancel() end
        colorTween = TweenService:Create(btn,TweenInfo.new(duration or 0.18),{BackgroundColor3=baseColor()})
        colorTween:Play()
    end
    btn.MouseEnter:Connect(function()
        hovered = true
        paint(0.14)
        TweenService:Create(st,TweenInfo.new(0.14),{Color=THEME.PurpleBright,Thickness=1.5,Transparency=0}):Play()
    end)
    btn.MouseLeave:Connect(function()
        hovered = false
        paint(0.14)
        TweenService:Create(st,TweenInfo.new(0.14),{Color=THEME.PurpleDark,Thickness=1,Transparency=0.25}):Play()
    end)
    btn:GetAttributeChangedSignal("ToggleActive"):Connect(function() paint(0.16) end)
    btn.MouseButton1Click:Connect(function()
        if isStale() or not controlGui or not controlGui.Parent
            or not btn:IsDescendantOf(controlGui) then return end
        paint(0.16)
        if fn then
            local ok, err = xpcall(fn,debug.traceback)
            if not ok then warn("[VisualTrade] Button '"..text.."' failed: "..tostring(err)) end
        end
    end)
    return btn
end

