local function setActiveTab(tabName)
    if currentTab == tabName then return end
    currentTab = tabName
    for name, data in pairs(tabButtons) do
        local active = name == tabName
        TweenService:Create(data.button,TweenInfo.new(0.2,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{
            BackgroundColor3       = active and THEME.PurpleDark or THEME.Panel2,
            BackgroundTransparency = active and 0 or 0.28,
        }):Play()
        TweenService:Create(data.stroke,TweenInfo.new(0.2),{
            Color        = active and THEME.PurpleBright or THEME.PurpleDark,
            Thickness    = active and 1.6 or 0.8,
            Transparency = active and 0 or 0.5,
        }):Play()
    end
    for name, frame in pairs(tabFrames) do
        if name == tabName then
            frame.Visible = true
            frame.Position = UDim2.new(0.05,12,0,108)
            TweenService:Create(frame,TweenInfo.new(0.24,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Position=UDim2.new(0.05,0,0,108)}):Play()
        else
            frame.Visible = false
        end
    end
end

