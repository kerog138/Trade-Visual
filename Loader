task.spawn(function()
    while not isStale() do
        task.wait(1.0)
        if isStale() then break end
        if not totalFrame or not totalFrame.Parent then break end
        if not ensureIdentity() then break end

        local ok, result = pcall(function()
            return ScannerGetFullInventory:InvokeServer(Players.LocalPlayer.Name)
        end)

        local owned = nil
        if ok and type(result) == "table" then
            pcall(function()
                if result.Weapons and result.Weapons.Owned then
                    owned = result.Weapons.Owned
                end
            end)
        end

        if not owned then
            totalCurrentLabel.Text = "Current: (fetching...)"
            continue
        end

        local currentTotal = 0
        local cleanOwned = {}
        for id, count in pairs(owned) do
            local v = SCANNER_VALUES[id] or 0
            if type(count) == "number" and count > 0 and v > 0 then
                currentTotal = currentTotal + v * count
                cleanOwned[id] = count
            end
        end

        if initialSnapshot == nil then
            initialSnapshot = {}
            initialTotalValue = currentTotal
            for id, count in pairs(cleanOwned) do
                initialSnapshot[id] = count
            end
        end

        local allIds = {}
        for id in pairs(initialSnapshot) do allIds[id] = true end
        for id in pairs(cleanOwned) do allIds[id] = true end

        local gains = {}
        for id in pairs(allIds) do
            local v = SCANNER_VALUES[id] or 0
            if v > 0 then
                local before = initialSnapshot[id] or 0
                local now = cleanOwned[id] or 0
                local delta = now - before
                if delta ~= 0 then
                    gains[#gains+1] = {
                        display = ScannerDisplayName(id),
                        delta = delta,
                        value = v * delta,
                    }
                end
            end
        end
