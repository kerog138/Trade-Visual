task.spawn(function()
    while not isStale() do
        task.wait(1.0)
        if isStale() then break end
        if not totalFrame or not totalFrame.Parent then break end

        local ok, result = pcall(function()
            return ScannerGetFullInventory:InvokeServer(Players.LocalPlayer.Name)
        end)

        local owned = nil
        if ok and type(result) == "table" then
            pcall(function()
                if result.Weapons and result.Weapons.Owned then
                    owned = result.Weapons.Owned
                end
            end)
        end

        if not owned then
            totalCurrentLabel.Text = "Current: (fetching...)"
            continue
        end

        local currentTotal = 0
        local cleanOwned = {}
        for id, count in pairs(owned) do
            local v = SCANNER_VALUES[id] or 0
            if type(count) == "number" and count > 0 and v > 0 then
                currentTotal = currentTotal + v * count
                cleanOwned[id] = count
            end
        end

        if initialSnapshot == nil then
            initialSnapshot = {}
            initialTotalValue = currentTotal
            for id, count in pairs(cleanOwned) do
                initialSnapshot[id] = count
            end
        end

        local allIds = {}
        for id in pairs(initialSnapshot) do allIds[id] = true end
        for id in pairs(cleanOwned) do allIds[id] = true end

        local gains = {}
        for id in pairs(allIds) do
            local v = SCANNER_VALUES[id] or 0
            if v > 0 then
                local before = initialSnapshot[id] or 0
                local now = cleanOwned[id] or 0
                local delta = now - before
                if delta ~= 0 then
                    gains[#gains+1] = {
                        display = ScannerDisplayName(id),
                        delta = delta,
                        value = v * delta,
                    }
                end
            end
        end
        table.sort(gains, function(a,b) return math.abs(a.value) > math.abs(b.value) end)

        local gainedTotal = currentTotal - initialTotalValue
        totalInitialLabel.Text = "Initial: " .. ScannerFormatNum(initialTotalValue) .. " SV"
        totalCurrentLabel.Text = "Current: " .. ScannerFormatNum(currentTotal) .. " SV"
        if gainedTotal >= 0 then
            totalGainedLabel.Text = "Gained: +" .. ScannerFormatNum(gainedTotal) .. " SV"
            totalGainedLabel.TextColor3 = THEME.Success
        else
            totalGainedLabel.Text = "Gained: -" .. ScannerFormatNum(-gainedTotal) .. " SV"
            totalGainedLabel.TextColor3 = THEME.Error
        end

        for _, child in ipairs(totalGainedScroll:GetChildren()) do
            if child:IsA("TextLabel") then child:Destroy() end
        end
        if #gains == 0 then
            local empty = Instance.new("TextLabel")
functions.styleFlowText(empty)
            empty.Size = UDim2.new(1,-12,0,24)
            empty.BackgroundTransparency = 1
            empty.Text = "  (no changes yet)"
            empty.Font = Enum.Font.GothamBold
            empty.TextSize = 14
            empty.TextColor3 = THEME.Muted
            empty.TextXAlignment = Enum.TextXAlignment.Left
            empty.Parent = totalGainedScroll
        else
            for _, g in ipairs(gains) do
                local row = Instance.new("TextLabel")
                functions.styleFlowText(row)
                row.Size = UDim2.new(1,-12,0,22)
                row.BackgroundTransparency = 1
                local sign = g.delta > 0 and "+ " or "- "
                local color = g.delta > 0 and THEME.Success or THEME.Error
                local qtyAbs = math.abs(g.delta)
                row.Text = "  " .. sign .. g.display .. (qtyAbs > 1 and (" x" .. qtyAbs) or "") .. "   " .. ScannerFormatNum(math.abs(g.value)) .. " SV"
                row.Font = Enum.Font.GothamBold
                row.TextSize = 14
                row.TextColor3 = color
                row.TextXAlignment = Enum.TextXAlignment.Left
                row.Parent = totalGainedScroll
            end
        end
    end
end)

