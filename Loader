                row.Text = "  " .. sign .. g.display .. (qtyAbs > 1 and (" x" .. qtyAbs) or "") .. "   " .. ScannerFormatNum(math.abs(g.value)) .. " SV"
                row.Font = Enum.Font.Gotham
                row.TextSize = 10
                row.TextColor3 = color
                row.TextXAlignment = Enum.TextXAlignment.Left
                row.Parent = totalGainedScroll
            end
        end
    end
end)

