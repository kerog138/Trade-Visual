-- Fit list viewports to the space below their controls; use a single scroll surface.
do
    local function fillRemainingSpace(tab, list, listLayout, listPadding)
        local outerLayout = tab:FindFirstChildOfClass("UIListLayout")
        local outerPadding = tab:FindFirstChildOfClass("UIPadding")
        list.AutomaticCanvasSize = Enum.AutomaticSize.None
        list.AutomaticSize = Enum.AutomaticSize.None
        list.ScrollingDirection = Enum.ScrollingDirection.Y
        list.ScrollingEnabled = true
        list.Active = true
        list.ClipsDescendants = true
        list.VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar
        list.LayoutOrder = 100
        local function pixels(value, height)
            return value.Offset + value.Scale * height
        end
        local function updateCanvas()
            if isStale() or not list.Parent then return end
            local height = math.ceil(listLayout.AbsoluteContentSize.Y
                + pixels(listPadding.PaddingTop,list.AbsoluteSize.Y)
                + pixels(listPadding.PaddingBottom,list.AbsoluteSize.Y))
            local size = UDim2.fromOffset(0,height)
            if list.CanvasSize ~= size then list.CanvasSize = size end
            local maxY = math.max(0,height-list.AbsoluteWindowSize.Y)
            local position = Vector2.new(0,math.clamp(list.CanvasPosition.Y,0,maxY))
            if list.CanvasPosition ~= position then list.CanvasPosition = position end
        end
        local function updateViewport()
            if isStale() or not tab.Parent or not list.Parent then return end
            local height = tab.AbsoluteSize.Y
            local used = pixels(outerPadding.PaddingTop,height)
                + pixels(outerPadding.PaddingBottom,height)
            local siblings = 0
            for _, child in ipairs(tab:GetChildren()) do
                if child:IsA("GuiObject") and child ~= list and child.Visible then
                    used = used + child.AbsoluteSize.Y
                    siblings = siblings + 1
                end
            end
            used = used + siblings * pixels(outerLayout.Padding,height)
            local size = UDim2.new(1,0,0,math.max(0,math.floor(height-used)))
            if list.Size ~= size then list.Size = size end
            updateCanvas()
        end
        local function watch(signal,callback)
            table.insert(externalConnections,signal:Connect(callback))
        end
        watch(tab:GetPropertyChangedSignal("AbsoluteSize"),updateViewport)
        watch(tab:GetPropertyChangedSignal("Visible"),updateViewport)
        for _, child in ipairs(tab:GetChildren()) do
            if child:IsA("GuiObject") and child ~= list then
                watch(child:GetPropertyChangedSignal("AbsoluteSize"),updateViewport)
                watch(child:GetPropertyChangedSignal("Visible"),updateViewport)
            end
        end
        watch(listLayout:GetPropertyChangedSignal("AbsoluteContentSize"),updateCanvas)
        watch(list:GetPropertyChangedSignal("AbsoluteWindowSize"),updateCanvas)
        updateViewport()
        task.defer(updateViewport)
    end
    fillRemainingSpace(playersFrame,playerListFrame,playerListLayout,playerListPadding)
    fillRemainingSpace(itemsFrame,weaponScrollFrame,wll,wlp)
end


-- Local visual trade cycles. Uses the same local offer/inventory functions as manual controls.
do
    local auto = { mode = nil, generation = 0, thread = nil, trade = nil, tween = nil, seeded = {} }
    lifecycle.tradeAutomation = auto
    local upgradeButton, giveawayButton, status
    local function refresh()
        upgradeButton.Text = "Auto Upgrade: "..(auto.mode == "upgrade" and "ON" or "OFF")
        giveawayButton.Text = "Auto Giveaway: "..(auto.mode == "giveaway" and "ON" or "OFF")
        upgradeButton:SetAttribute("ToggleActive",auto.mode == "upgrade")
        upgradeButton.BackgroundColor3 = auto.mode == "upgrade" and THEME.Success or THEME.Panel2
        giveawayButton:SetAttribute("ToggleActive",auto.mode == "giveaway")
        giveawayButton.BackgroundColor3 = auto.mode == "giveaway" and THEME.Success or THEME.Panel2
    end
    local function stop(message)
        auto.generation = auto.generation + 1
        auto.mode = nil
        if auto.tween then auto.tween:Cancel(); auto.tween = nil end
        local worker = auto.thread
        auto.thread = nil
        if worker and worker ~= coroutine.running() then
            pcall(lifecycle.nativeTask.cancel,worker)
            lifecycle.threads[worker] = nil
        end
        if auto.trade and TradeTable == auto.trade then
            ResetCooldown(true)
            TradeGUI.Container.Trade.Actions.Accept.ActionButton.Visible = true
            TradeGUI.Container.Trade.Actions.Accept.Cancel.Visible = false
            functions.DeclineTrade()
        end
        if auto.trade and auto.trade.Completed then table.clear(auto.seeded) end
        auto.trade = nil
        for id, amount in pairs(auto.seeded) do RemoveItem(id,amount,"Weapons") end
        table.clear(auto.seeded)
        refresh()
        status.Text = message or "Automation stopped."
        local stoppedGeneration = auto.generation
        task.delay(3,function()
            if isStale() or auto.generation ~= stoppedGeneration or auto.mode then return end
            if status and status.Parent then status.Text = "" end
        end)
    end
    auto.stop = stop
    local function randomPartner()
        local starts = {"pickle","cloud","pixel","cozy","moon","toast","leaf","blue","sleepy","tiny","frost","lucky"}
        local ends = {"man","fox","bean","bird","cat","star","bear","wolf","bunny","mint","wave","panda"}
        return starts[math.random(#starts)]..ends[math.random(#ends)]..tostring(math.random(100,9999))
    end
    local function buildPools()
        local valued, godlies = {}, {}
        for _, id in ipairs(rareWeaponsList) do
            local data = Sync.Weapons and Sync.Weapons[id]
            if type(data) == "table" and not untradableItems[id] then
                local value = SCANNER_VALUES[id]
                if string.lower(tostring(data.Rarity)) == "godly"
                    and type(value) == "number" and value > 0 and value <= 1000 then
                    godlies[#godlies+1] = id
                end
                if type(value) == "number" and value > 0 then
                    valued[#valued+1] = {id=id,value=value}
                end
            end
        end
        table.sort(valued,function(a,b)
            if a.value == b.value then return a.id < b.id end
            return a.value < b.value
        end)
        return valued,godlies
    end
    local function pickerButton(id)
        for _, child in ipairs(weaponScrollFrame:GetChildren()) do
            if child:IsA("TextButton") and child.Text == id then return child end
        end
    end
    local function chooseUpgrade(valued)
        local pairsAvailable = {}
        for _, received in ipairs(valued) do
            if received.value >= 100 and received.value < 3000 and pickerButton(received.id) then
                for _, returned in ipairs(valued) do
                    if returned.value >= received.value * 1.2 and returned.value <= received.value * 2 then
                        pairsAvailable[#pairsAvailable+1] = {received,returned}
                        break
                    end
                end
            end
        end
        assert(#pairsAvailable > 0,"No valid under-3000 upgrade pairs were found in the scanner values.")
        return table.unpack(pairsAvailable[math.random(#pairsAvailable)])
    end
    local function chooseFour(pool)
        assert(#pool >= 4,"At least four Godly weapons are required in the weapon database.")
        local shuffled = table.clone(pool)
        for i=1,4 do
            local j = math.random(i,#shuffled)
            shuffled[i],shuffled[j] = shuffled[j],shuffled[i]
        end
        return {shuffled[1],shuffled[2],shuffled[3],shuffled[4]}
    end
    local function start(mode)
        if auto.mode == mode then stop(); return end
        if auto.mode then stop() end
        if Config.in_trade then
            status.Text = "Finish or decline the current trade before starting automation."
            return
        end
        auto.mode = mode
        auto.generation = auto.generation + 1
        local generation = auto.generation
        refresh()
        local function alive()
            return not isStale() and auto.mode == mode and auto.generation == generation
        end
        local function check()
            assert(alive(),"Automation cancelled.")
            if auto.trade and auto.trade.Completed then
                auto.trade = nil
                table.clear(auto.seeded)
            end
            if auto.trade then
                assert(TradeTable == auto.trade and Config.in_trade and TradeGUI.Enabled,
                    "Trade closed or changed; automation stopped.")
                assert(TradeTable.Player2.Player == auto.partner,"Trade partner changed; automation stopped.")
            end
        end
        local function pause(seconds)
            local deadline = os.clock()+seconds
            repeat
                check()
                task.wait(math.min(0.05,math.max(0,deadline-os.clock())))
            until os.clock() >= deadline
            check()
        end
        local function seed(id)
            local has,amount = CheckForItem(id,"Weapons")
            if not has or type(amount) ~= "number" or amount < 1 then
                SpawnItem(id,1,"Weapons")
                auto.seeded[id] = (auto.seeded[id] or 0)+1
            end
        end
        local function beginTrade(partner)
            check()
            assert(not Config.in_trade,"Another trade is already open.")
            auto.partner = partner
            TradeTable.Player2.Player = partner
            PartnerUserBox.Text = partner
            local search = TradeGUI.Container.Items.Tabs.Search.Container.SearchText
            search.Text = ""
            functions.StartTrade()
            auto.trade = TradeTable
            check()
            pause(2.3)
        end
        local function scrollTo(frame, scroll)
            check()
            assert(frame and frame.Parent and scroll,"Item is missing from the selector.")
            local viewport = scroll.AbsoluteWindowSize.Y
            local current = scroll.CanvasPosition.Y
            local top = frame.AbsolutePosition.Y-scroll.AbsolutePosition.Y
            local bottom = top+frame.AbsoluteSize.Y
            local margin = math.min(12,viewport*0.06)
            if top >= margin and bottom <= viewport-margin then return end
            local limit = math.max(0,scroll.AbsoluteCanvasSize.Y-viewport)
            local lowest = math.clamp(current+bottom-viewport+margin,0,limit)
            local highest = math.clamp(current+top-margin,0,limit)
            if lowest > highest then lowest,highest=highest,lowest end
            local destination = lowest+(highest-lowest)*(0.12+math.random()*0.76)
            local delta = destination-current
            if math.abs(delta)<2 then return end
            local direction = delta>0 and 1 or -1
            local overshootDistance = math.max(95,math.min(235,math.abs(delta)*(0.28+math.random()*0.16)))
            local overshoot = math.clamp(destination+direction*overshootDistance,0,limit)
            -- If the far edge prevents that overshoot, cross the target from the other side.
            if math.abs(overshoot-destination)<50 then
                overshoot = math.clamp(destination-direction*overshootDistance,0,limit)
            end
            local function glide(y,duration,style)
                auto.tween = TweenService:Create(scroll,TweenInfo.new(duration,style,Enum.EasingDirection.Out),{
                    CanvasPosition=Vector2.new(0,y),
                })
                auto.tween:Play()
                pause(duration)
            end
            local span = overshoot-current
            local pace = math.clamp(math.abs(span)/750,0.45,1.5)
            local first = 0.26+math.random()*0.13
            local second = 0.65+math.random()*0.14
            glide(math.clamp(current+span*first,0,limit),pace*0.29,Enum.EasingStyle.Quad)
            glide(math.clamp(current+span*second,0,limit),pace*0.37,Enum.EasingStyle.Linear)
            glide(overshoot,pace*0.34,Enum.EasingStyle.Quart)
            -- Return in two uneven motions, ending anywhere that keeps the item visible.
            local correction = destination-overshoot
            glide(math.clamp(overshoot+correction*(0.62+math.random()*0.18),0,limit),
                0.18+math.random()*0.15,Enum.EasingStyle.Quad)
            glide(destination,0.14+math.random()*0.20,Enum.EasingStyle.Sine)
            auto.tween = nil
        end
        local function selectOwn(id)
            local data = TradeInventory and TradeInventory.Data and TradeInventory.Data.Weapons
            local frame
            if data then
                for _, group in pairs(data) do
                    if type(group)=="table" and group[id] then frame=group[id].Frame; break end
                end
            end
            assert(frame and frame.Parent,"Weapon "..id.." is missing from the trade selector.")
            local node,scroll = frame,nil
            while node and node ~= TradeGUI do
                if node:IsA("GuiObject") then node.Visible=true end
                if node:IsA("ScrollingFrame") and not scroll then scroll=node end
                node=node.Parent
            end
            assert(scroll,"Could not locate the weapon selector scroll frame.")
            -- Switch the category page without invoking a trade remote.
            for _, sibling in ipairs(scroll.Parent:GetChildren()) do
                if sibling:IsA("ScrollingFrame") and sibling~=scroll then sibling.Visible=false end
            end
            scrollTo(frame,scroll)
            OfferItemLocalPlayer(id,"Weapons",true)
            local found=false
            for _, item in ipairs(TradeTable.Player1.Offer) do if item[1]==id then found=true end end
            assert(found,"Could not add "..id.." to your offer.")
        end

        local function claimRewards()
            status.Text = "Waiting for the reward claim..."
            local function visible(button)
                local node = button
                while node and node ~= guiParent do
                    if node:IsA("GuiObject") and not node.Visible then return false end
                    if node:IsA("ScreenGui") and not node.Enabled then return false end
                    node = node.Parent
                end
                return node == guiParent and button.AbsoluteSize.X > 0 and button.AbsoluteSize.Y > 0
            end
            local function isClaim(text)
                return type(text)=="string" and text:lower():gsub("[^%a]","")=="claim"
            end
            local function findClaim()
                for _, button in ipairs(guiParent:GetDescendants()) do
                    if button:IsA("GuiButton") and not button:IsDescendantOf(controlGui) and visible(button) then
                        local matched = isClaim(button.Name) or (button:IsA("TextButton") and isClaim(button.Text))
                        if not matched then
                            for _, label in ipairs(button:GetDescendants()) do
                                if label:IsA("TextLabel") and isClaim(label.Text) then matched=true; break end
                            end
                        end
                        if matched then return button end
                    end
                end
            end
            local function press(button)
                -- Invoke the existing claim handler when the executor exposes connections.
                if getconnections then
                    for _, signal in ipairs({button.MouseButton1Click,button.Activated}) do
                        local ok, connections = pcall(getconnections,signal)
                        if ok and type(connections)=="table" then
                            local invoked = false
                            for _, connection in ipairs(connections) do
                                if connection.Enabled ~= false and type(connection.Function)=="function" then
                                    connection.Function()
                                    invoked = true
                                end
                            end
                            if invoked then return end
                        end
                    end
                end
                -- Otherwise send one actual click to the center of the visible button.
                local ok = pcall(function()
                    local input = game:GetService("VirtualInputManager")
                    local inset = game:GetService("GuiService"):GetGuiInset()
                    local screen = button:FindFirstAncestorOfClass("ScreenGui")
                    if screen and screen.IgnoreGuiInset then inset=Vector2.new(0,0) end
                    local point = button.AbsolutePosition + button.AbsoluteSize/2 + inset
                    input:SendMouseButtonEvent(point.X,point.Y,0,true,game,0)
                    input:SendMouseButtonEvent(point.X,point.Y,0,false,game,0)
                end)
                assert(ok,"Cannot click Claim in this executor. Claim the reward manually, then restart the toggle.")
            end
            local deadline = os.clock()+6
            local button = findClaim()
            while not button and os.clock()<deadline do pause(0.1);button=findClaim() end
            assert(button,"Claim button not found. Claim the reward manually before restarting.")
            for _=1,5 do
                pause(0.35)
                check()
                if button.Parent and visible(button) then press(button) end
                local closedBy = os.clock()+5
                while button.Parent and visible(button) and os.clock()<closedBy do pause(0.1) end
                assert(not button.Parent or not visible(button),"Claim did not close the reward popup; automation stopped.")
                pause(0.2)
                button=findClaim()
                if not button then status.Text="Reward claimed.";return end
            end
            error("More reward popups remain; claim them manually before restarting.")
        end
        local function accept()
            check()
            if not Config.in_trade then return end
            status.Text = "Waiting for the trade cooldown..."
            -- The first item started the countdown; each later item restarted it.
            while v84 or v85 > 0 do
                pause(0.1)
            end
            check()
            if not Config.in_trade then return end
            pause(0.1+math.random()*0.2)
            if not Config.in_trade then return end
            TheirOffer.Accepted.Visible = true
            TradeTable.Player2.Accepted = true
            status.Text = "Partner accepted. Confirming your offer..."
            pause(0.25+math.random()*0.25)
            check()
            if not Config.in_trade then return end
            -- First press: Accept becomes the game's Are You Sure? confirmation.
            v35 = "Confirm"
            v87 = time()
            TradeGUI.Container.Trade.Actions.Accept.Confirm.Visible = true
            status.Text = "Are you sure?"
            pause(0.25)
            check()
            if not Config.in_trade then return end
            -- Second press: our side accepts and the control becomes Cancel.
            YourOffer.Accepted.Visible = true
            TradeTable.Player1.Accepted = true
            v35 = "Waiting"
            TradeGUI.Container.Trade.Actions.Accept.Confirm.Visible = false
            TradeGUI.Container.Trade.Actions.Accept.ActionButton.Visible = false
            TradeGUI.Container.Trade.Actions.Accept.Cancel.Visible = true
            status.Text = "Both sides accepted. Finishing trade..."
            local expected = auto.trade
            AcceptTrade(expected,alive)
            assert(alive(),"Automation cancelled.")
            assert(not Config.in_trade,"Trade did not finish.")
            auto.trade = nil
            -- Seeded outgoing copies were consumed by AcceptTrade's local inventory update.
            table.clear(auto.seeded)
        end
        auto.thread = task.defer(function()
            local ok,err = xpcall(function()
                local valued,godlies = buildPools()
                while alive() do
                    local partner = randomPartner()
                    if mode == "upgrade" then
                        local received,returned = chooseUpgrade(valued)
                        status.Text = "Receiving "..ScannerDisplayName(received.id).." ("..received.value.." SV)..."
                        beginTrade(partner)
                        -- Partner-side items appear directly in the trade offer; the deliberate
                        -- selector scrolling is reserved for items added from our inventory.
                        pause(0.2)
                        assert(OfferItemAnotherPlayer(received.id,"Weapons",true),"Could not add the partner's item.")
                        pause(0.15)
                        accept()
                        claimRewards()
                        setActiveTab("Control")
                        pause(1.8)
                        status.Text = "Returning "..ScannerDisplayName(received.id).." + "..ScannerDisplayName(returned.id).." to "..partner.."..."
                        seed(returned.id)
                        beginTrade(partner)
                        selectOwn(received.id)
                        pause(2.4)
                        selectOwn(returned.id)
                        pause(1.8)
                        accept()
                    else
                        local items = chooseFour(godlies)
                        for _,id in ipairs(items) do seed(id) end
                        status.Text = "Giving four Godlies to "..partner.."..."
                        beginTrade(partner)
                        for i,id in ipairs(items) do
                            check()
                            selectOwn(id)
                            -- Read the selected item, then scroll to the next one (about 2.5 seconds per addition).
                            if i < #items then pause(2.4) end
                        end
                        accept()
                    end
                    status.Text = "Cycle complete. Next partner in 3 seconds..."
                    pause(3)
                end
            end,debug.traceback)
            if auto.generation == generation then
                stop(ok and "Automation stopped." or "Stopped: "..tostring(err):match("^[^\n]+"))
                if not ok then warn("[VisualTrade] Automation: "..tostring(err)) end
            end
        end)
    end
    upgradeButton = CreateButton(controlFrame,"Auto Upgrade: OFF",function()
        start("upgrade")
        return auto.mode == "upgrade" and THEME.Success or THEME.Panel2
    end)
    giveawayButton = CreateButton(controlFrame,"Auto Giveaway: OFF",function()
        start("giveaway")
        return auto.mode == "giveaway" and THEME.Success or THEME.Panel2
    end)
    local groupGap = Instance.new("Frame")
    groupGap.Name = "AutomationGroupGap"
    groupGap.Size = UDim2.new(1,0,0,18)
    groupGap.BackgroundTransparency = 1
    groupGap.LayoutOrder = 7
    groupGap.Parent = controlFrame
    upgradeButton.LayoutOrder = 8
    giveawayButton.LayoutOrder = 9
    upgradeButton:SetAttribute("TooltipText","Toggle a local visual cycle: receive an item worth 100-2,999 SV, claim it, then return that original item PLUS a second item worth at least 20% more, rounded up within 2x. Uses slower selection and a 3-second pause between cycles.")
    giveawayButton:SetAttribute("TooltipText","Toggle a local visual giveaway: choose a generated partner, scroll to four distinct Godly weapons each worth at most 1,000 SV, add them about 2.5 seconds apart, and accept after the cooldown. Waits 3 seconds between cycles. Switching modes stops the previous one.")
    status = Instance.new("TextLabel")
    functions.styleFlowText(status)
    status.Size = UDim2.new(1,0,0,18)
    status.BackgroundTransparency = 1
    status.Font = Enum.Font.GothamBold
    status.TextSize = 14
    status.TextColor3 = THEME.Success
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.Text = ""
    status.LayoutOrder = 10
    status.Parent = controlFrame
    refresh()
end

-- Track the game's trade window, separately from this script's visual trades.
do
    local enabled=false
    local lastPartner
    local button
    local realTrade={active=false,partner=nil,bothAccepted=false,sawUnaccepted=false}
    local function findServerPlayer(value,seen)
        if typeof(value)=="Instance" and value:IsA("Player") then
            return value~=Players.LocalPlayer and value or nil
        end
        if type(value)=="number" then
            local player=Players:GetPlayerByUserId(value)
            return player~=Players.LocalPlayer and player or nil
        end
        if type(value)=="table" then
            seen=seen or {}
            if seen[value] then return nil end
            seen[value]=true
            for _,key in ipairs({"Partner","Player2","Player","Target","Username","UserName","Name","UserId","userId"}) do
                local player=findServerPlayer(value[key],seen)
                if player then return player end
            end
            return nil
        end
        if type(value)~="string" then return nil end
        local name=value:match("%((.-)%)") or value
        name=name:match("^%s*@?(.-)%s*$")
        if not name or name=="" then return nil end
        for _,player in ipairs(Players:GetPlayers()) do
            if player~=Players.LocalPlayer and player.Name:lower()==name:lower() then return player end
        end
        local displayMatch
        for _,player in ipairs(Players:GetPlayers()) do
            if player~=Players.LocalPlayer and player.DisplayName:lower()==name:lower() then
                if displayMatch then return nil end
                displayMatch=player
            end
        end
        return displayMatch
    end
    local function partnerFromWindow()
        return findServerPlayer(TheirOffer.Username.Text)
    end
    local function selectLastPartner()
        if not enabled or not lastPartner or isStale() or Config.in_trade then return end
        if not PartnerUserBox or not PartnerUserBox.Parent then return end
        PartnerUserBox.Text=lastPartner
        TradeTable.Player2.Player=lastPartner
    end
    local function observeRealTrade()
        if isStale() or Config.in_trade or not TradeGUI.Enabled then return end
        realTrade.active=true
        local player=partnerFromWindow()
        if player then realTrade.partner=player.Name end
        local both=YourOffer.Accepted.Visible and TheirOffer.Accepted.Visible
        if not both then realTrade.sawUnaccepted=true end
        if both and realTrade.sawUnaccepted then realTrade.bothAccepted=true end
    end
    onRealTradeStarted=function(arg1,arg2)
        if Config.in_trade then return end
        local alreadyOpen=realTrade.active and TradeGUI.Enabled
        realTrade.active=true
        if not alreadyOpen then
            realTrade.bothAccepted=false
            realTrade.sawUnaccepted=false
        end
        local player=findServerPlayer(arg1) or findServerPlayer(arg2)
        realTrade.partner=player and player.Name or nil
        task.defer(observeRealTrade)
        task.delay(0.2,observeRealTrade)
    end
    table.insert(externalConnections,TradeGUI:GetPropertyChangedSignal("Enabled"):Connect(function()
        if TradeGUI.Enabled then
            observeRealTrade()
        else
            local accepted=realTrade.bothAccepted or (realTrade.sawUnaccepted
                and YourOffer.Accepted.Visible and TheirOffer.Accepted.Visible)
            if realTrade.active and accepted and not Config.in_trade then
                local player=partnerFromWindow()
                local name=realTrade.partner or (player and player.Name)
                if name then
                    lastPartner=name
                    selectLastPartner()
                end
            end
            realTrade.active=false
            realTrade.partner=nil
            realTrade.bothAccepted=false
            realTrade.sawUnaccepted=false
        end
    end))
    table.insert(externalConnections,TheirOffer.Username:GetPropertyChangedSignal("Text"):Connect(observeRealTrade))
    table.insert(externalConnections,YourOffer.Accepted:GetPropertyChangedSignal("Visible"):Connect(observeRealTrade))
    table.insert(externalConnections,TheirOffer.Accepted:GetPropertyChangedSignal("Visible"):Connect(observeRealTrade))
    table.insert(externalConnections,game:GetService("RunService").Heartbeat:Connect(function()
        if realTrade.active and TradeGUI.Enabled and not Config.in_trade then
            local both=YourOffer.Accepted.Visible and TheirOffer.Accepted.Visible
            if not both then realTrade.sawUnaccepted=true end
            if both and realTrade.sawUnaccepted then realTrade.bothAccepted=true end
        end
    end))
    observeRealTrade()
    local gap=Instance.new("Frame")
    gap.Name="LastTradeSelectionGroupGap"
    gap.Size=UDim2.new(1,0,0,18)
    gap.BackgroundTransparency=1
    gap.LayoutOrder=11
    gap.Parent=controlFrame
    local heading=Instance.new("TextLabel")
    heading.Name="LastTradeSelectionHeading"
    heading.Size=UDim2.new(1,0,0,18)
    heading.BackgroundTransparency=1
    heading.Font=Enum.Font.GothamBold
    heading.TextSize=12
    heading.TextColor3=THEME.PurpleBright
    heading.TextXAlignment=Enum.TextXAlignment.Left
    heading.Text="TRADE PARTNER SELECTION"
    heading.LayoutOrder=12
    heading.Parent=controlFrame
    button=CreateButton(controlFrame,"Auto Select Last Trader: OFF",function()
        enabled=not enabled
        button.Text="Auto Select Last Trader: "..(enabled and "ON" or "OFF")
        button:SetAttribute("ToggleActive",enabled)
        selectLastPartner()
    end)
    button.LayoutOrder=13
    button:SetAttribute("TooltipText","After a real game trade shows both sides accepted and closes, select that server player in Control. Visual trades in this script do not count.")
end

