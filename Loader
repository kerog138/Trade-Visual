local BASE_HEADERS = {
    ["Origin"] = "https://www.roblox.com",
    ["Referer"] = "https://www.roblox.com/",
    ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    ["Accept"] = "application/json",
}

local function fetchCsrf()
    if State.cookie == "" then return nil end
    local h = {}
    for k, v in pairs(BASE_HEADERS) do h[k] = v end
    h["Cookie"] = ".ROBLOSECURITY=" .. State.cookie
    h["Content-Type"] = "application/json"

    local res = httpRequest({Url = "https://auth.roblox.com/v2/logout", Method = "POST", Headers = h, Body = "{}"})
    if not res then return nil end
    local tok = getHeader(res.Headers, "x-csrf-token")
    if tok then State.csrf = tok end
    return tok
end

local function fetchAuthenticatedUser()
    if State.cookie == "" then return nil, "no cookie" end
    local h = {}
    for k, v in pairs(BASE_HEADERS) do h[k] = v end
    h["Cookie"] = ".ROBLOSECURITY=" .. State.cookie

    local res, err = httpRequest({Url = "https://users.roblox.com/v1/users/authenticated", Method = "GET", Headers = h})
    if not res then return nil, "network error: " .. tostring(err) end
    if res.StatusCode ~= 200 then return nil, "HTTP " .. tostring(res.StatusCode) end
    local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not ok or type(data) ~= "table" or not data.id then return nil, "bad response" end
    State.authName = data.name
    return data, nil
end

local function resolveUsername(name)
    if type(name) ~= "string" or name == "" then return nil, "empty" end
    name = name:match("^%s*(.-)%s*$")
    local body = HttpService:JSONEncode({usernames = { name }, excludeBannedUsers = false})
    local h = {}
    for k, v in pairs(BASE_HEADERS) do h[k] = v end
    h["Cookie"] = ".ROBLOSECURITY=" .. State.cookie
    h["Content-Type"] = "application/json"

    local res, err = httpRequest({Url = "https://users.roblox.com/v1/usernames/users", Method = "POST", Headers = h, Body = body})
    if not res then return nil, "network error" end
    
    if res.StatusCode == 403 then
        local tok = getHeader(res.Headers, "x-csrf-token")
        if tok then
            h["X-CSRF-TOKEN"] = tok
            res = httpRequest({Url = "https://users.roblox.com/v1/usernames/users", Method = "POST", Headers = h, Body = body})
        end
    end

    if not res then return nil, "network error" end
    if res.StatusCode ~= 200 then return nil, "HTTP " .. tostring(res.StatusCode) end
    local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not ok or type(data) ~= "table" or type(data.data) ~= "table" or not data.data[1] then
        return nil, "user not found"
    end
    return { id = data.data[1].id, name = data.data[1].name }, nil
end

local function doBlock(userId)
    if not userId then return false, "no userId" end
    if not State.csrf then fetchCsrf() end
    if not State.csrf then return false, "csrf failed" end

    local url = "https://apis.roblox.com/user-blocking-api/v1/users/" .. tostring(userId) .. "/block-user"

    local function attempt()
        local h = {}
        for k, v in pairs(BASE_HEADERS) do h[k] = v end
        local cookieStr = ".ROBLOSECURITY=" .. State.cookie
        if State.browserTrackerId and State.browserTrackerId ~= "" then
            cookieStr = cookieStr .. "; RBXEventTrackerV2=browserid=" .. State.browserTrackerId
        end
        h["Cookie"] = cookieStr
        h["X-CSRF-TOKEN"] = State.csrf
        h["Content-Type"] = "application/json"
        return httpRequest({Url = url, Method = "POST", Headers = h, Body = "{}"})
    end

    local res = attempt()
    if not res then return false, "network error" end

    if res.StatusCode == 403 then
        local tok = getHeader(res.Headers, "x-csrf-token")
        if tok then State.csrf = tok end
        res = attempt()
    end

    if not res then return nil, "network error (retry)" end
    if res.StatusCode == 200 or res.StatusCode == 204 then return true end
    if res.StatusCode == 429 then return false, "rate limited" end
    return false, "HTTP " .. tostring(res.StatusCode)
end

