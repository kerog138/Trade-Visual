local SCANNER_GREEN_THRESHOLD = 25

local function UpdateScannerCard(card, result)
    local headerRow  = card:FindFirstChild("HeaderRow")
    local totalLabel = card:FindFirstChild("TotalLabel")
    local itemsLabel = card:FindFirstChild("ItemsLabel")
    local cardStroke = card:FindFirstChild("CardStroke")

    if not result then
        if totalLabel then totalLabel.Text = "Total SV: N/A" end
        if itemsLabel then
            itemsLabel.Text = "  could not fetch inventory"
            itemsLabel.TextColor3 = THEME.Error
        end
        if cardStroke then
            cardStroke.Color = THEME.PurpleDark
            cardStroke.Transparency = 0.2
        end
        return
    end

    local owned = {}
    pcall(function()
        for id, qty in pairs(result.Weapons.Owned) do
            if type(qty) == "number" and qty > 0 then owned[tostring(id)] = qty end
        end
    end)

    if not next(owned) then
        local function flatten(t, depth)
            if type(t) ~= "table" or depth > 6 then return end
            for k, v in pairs(t) do
                local key = tostring(k)
                if type(v) == "number" and v > 0 then
                    owned[key] = (owned[key] or 0) + v
                elseif type(v) == "table" then
                    local amount = v.Amount or v.amount or v.Count or v.count
                    if type(amount) == "number" and amount > 0 then
                        owned[key] = (owned[key] or 0) + amount
                    else
                        flatten(v, depth + 1)
                    end
                elseif type(v) == "boolean" and v == true then
                    owned[key] = (owned[key] or 0) + 1
                end
            end
        end
        flatten(result, 0)
    end

    local matched = {}
    local totalSV  = 0

    for id, qty in pairs(owned) do
        local value = SCANNER_VALUES[id]
        if value then
            local itemTotal = value * qty
            totalSV = totalSV + itemTotal
            table.insert(matched, {
                display = ScannerDisplayName(id),
                qty     = qty,
                value   = value,
                total   = itemTotal,
            })
        end
    end

    table.sort(matched, function(a, b) return a.total > b.total end)

    if Config.auto_block and totalSV < SCANNER_GREEN_THRESHOLD then
        local pName = card.Name
        if pName ~= Players.LocalPlayer.Name and not AutoBlockQueuedNames[pName] and not AutoBlockBlockedNames[pName] then
            AutoBlockQueuedNames[pName] = true
            table.insert(AutoBlockQueue, pName)
        end
    end

    if cardStroke then
        if totalSV >= SCANNER_GREEN_THRESHOLD then
            cardStroke.Color = THEME.Success
            cardStroke.Transparency = 0
        else
            cardStroke.Color = THEME.PurpleDark
            cardStroke.Transparency = 0.2
        end
    end

    if totalLabel then
        totalLabel.Text = "Total SV: " .. ScannerFormatNum(totalSV) .. "  ·  " .. #matched .. " item(s)"
    end

    if itemsLabel then
        if #matched == 0 then
            itemsLabel.Text = "  (no valued items found)"
            itemsLabel.TextColor3 = THEME.Muted
        else
            local lines = {}
            for _, entry in ipairs(matched) do
                local qtyText = entry.qty > 1 and (" x" .. entry.qty) or ""
                table.insert(lines, "  • " .. entry.display .. qtyText .. "   " .. ScannerFormatNum(entry.total) .. " SV")
            end
            itemsLabel.Text = table.concat(lines, "\n")
            itemsLabel.TextColor3 = THEME.Text
        end
    end
end

local function FetchAndUpdateScannerCard(player, card)
    local ok, result = pcall(function()
        return ScannerGetFullInventory:InvokeServer(player.Name)
    end)
    if card and card.Parent then
        UpdateScannerCard(card, ok and type(result) == "table" and result or nil)
    end
    if player == Players.LocalPlayer and ok and type(result) == "table" then
        scannerLocalOwned = (result.Weapons and result.Weapons.Owned) or {}
    end
end

local function EnsureScannerCard(player, order)
    local card = scannerCards[player.Name]
    if not card or not card.Parent then
        card = MakeScannerCard(player.Name, order)
        if not card then return nil end
        scannerCards[player.Name] = card
    end
    card.LayoutOrder = order
    return card
end

