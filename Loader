    layer.Name = "TooltipLayer"
    layer.Size = UDim2.fromScale(1,1)
    layer.BackgroundTransparency = 1
    layer.BorderSizePixel = 0
    layer.Active = false
    layer.ZIndex = 1000
    layer.Parent = controlGui

    local popup = Instance.new("Frame")
    popup.Name = "ButtonTooltip"
    popup.BackgroundColor3 = Color3.fromRGB(24,20,31)
    popup.BorderSizePixel = 0
    popup.Active = false
    popup.Visible = false
    popup.ZIndex = 1001
    popup.Parent = layer
    Instance.new("UICorner",popup).CornerRadius = UDim.new(0,7)
    local border = Instance.new("UIStroke")
    border.Color = THEME.PurpleBright
    border.Transparency = 0.55
    border.Thickness = 1
    border.Parent = popup

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.fromOffset(12,10)
    label.Size = UDim2.new(1,-24,1,-20)
    label.Font = Enum.Font.Gotham
    label.TextSize = 13
    label.TextColor3 = THEME.Text
    label.TextWrapped = true
    label.RichText = false
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.Active = false
    label.ZIndex = 1002
    label.Parent = popup

    local hovered, enteredAt, suppressed = nil, 0, false
    local lastText, lastWidth = nil, nil
    local textService = game:GetService("TextService")
    local guiService = game:GetService("GuiService")
    local bound = setmetatable({}, {__mode = "k"})

    local function describe(button)
        local custom = button:GetAttribute("TooltipText")
        if custom then return custom end
        if button == closeBtn then
            return "Close the panel, stop its workers, and restore the inventory display to your real items."
        elseif button == lifecycle.window.minimizeButton then
            return lifecycle.window.minimized and "Restore the full panel." or "Collapse the panel to its header. Click again to restore it."
        elseif button == autoBlockBtn then
            if autoBlockChecking then return "Checking the saved account before enabling Auto Block." end
            return Config.auto_block
                and "Turn off automatic blocking of players whose scanned inventory totals less than 25 SV."
                or "Automatically block other players whose scanned inventory totals less than 25 SV. Requires validated Auth details."
        elseif button.Parent == playerListFrame then
            return "Select @"..button.Name.." as the visual trade partner and open the Control tab."
        elseif button.Parent == weaponScrollFrame then
            return "Add "..button.Text.." to the partner's side of the visual trade."
        end
        return descriptions[button.Text]
    end

    local function hide()
        popup.Visible = false
    end
    local function bind(button)
        if not button:IsA("GuiButton") or bound[button] then return end
        bound[button] = true
        -- Instance-owned signals disconnect automatically when dynamic buttons are destroyed.
        button.MouseEnter:Connect(function()
            hovered = button
            enteredAt = os.clock()
            suppressed = false
            hide()
        end)
        button.MouseLeave:Connect(function()
            if hovered == button then hovered = nil; hide() end
        end)
        button.MouseButton1Down:Connect(function()
            if hovered == button then suppressed = true; hide() end
        end)
    end
    for _, object in ipairs(controlGui:GetDescendants()) do bind(object) end
    table.insert(externalConnections, controlGui.DescendantAdded:Connect(bind))
    table.insert(externalConnections, UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            suppressed = true
            hide()
        end
    end))
    table.insert(externalConnections, game:GetService("RunService").RenderStepped:Connect(function()
        if isStale() or not controlGui or not controlGui.Enabled
            or not hovered or not hovered.Parent or suppressed then hide(); return end
        if not hovered:IsDescendantOf(controlGui) then hovered = nil; hide(); return end
        local mouse = UserInputService:GetMouseLocation()
        if not controlGui.IgnoreGuiInset then mouse = mouse - guiService:GetGuiInset() end
        -- Hidden tabs and clipped/scrolled-out rows must never leave a tooltip behind.
        local ancestor = hovered
        while ancestor and ancestor ~= controlGui do
            if ancestor:IsA("GuiObject") then
                if not ancestor.Visible then hide(); return end
                if ancestor == hovered or ancestor.ClipsDescendants then
                    local pos, size = ancestor.AbsolutePosition, ancestor.AbsoluteSize
                    if mouse.X < pos.X or mouse.Y < pos.Y
                        or mouse.X > pos.X+size.X or mouse.Y > pos.Y+size.Y then hide(); return end
                end
            end
            ancestor = ancestor.Parent
        end
        if os.clock()-enteredAt < 0.45 then hide(); return end
        local description = describe(hovered)
        if not description then hide(); return end
        local screen = layer.AbsoluteSize
        local width = math.min(280, math.max(48,screen.X-16))
        if description ~= lastText or width ~= lastWidth then
            local natural = textService:GetTextSize(description,13,label.Font,Vector2.new(10000,10000))
            width = math.min(width,natural.X+24)
            local bounds = textService:GetTextSize(description,13,label.Font,Vector2.new(width-24,10000))
            popup.Size = UDim2.fromOffset(width,math.ceil(bounds.Y)+22)
            label.Text = description
            lastText, lastWidth = description, math.min(280, math.max(48,screen.X-16))
        end
        local point = mouse-layer.AbsolutePosition
        local size = popup.Size
        local w,h = size.X.Offset,size.Y.Offset
        local x,y = point.X+16,point.Y+22
        if x+w > screen.X-8 then x = point.X-w-16 end
        if y+h > screen.Y-8 then y = point.Y-h-14 end
        popup.Position = UDim2.fromOffset(
            math.clamp(x,8,math.max(8,screen.X-w-8)),
            math.clamp(y,8,math.max(8,screen.Y-h-8)))
        popup.Visible = true
    end))
end

