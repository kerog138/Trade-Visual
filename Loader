function lifecycle.cleanup(fromDestroy)
    if lifecycle.closed then return end
    lifecycle.closed = true
    if lifecycle.window and lifecycle.window.tween then lifecycle.window.tween:Cancel() end
    local wasVisualTrade = Config.in_trade
    Config.in_trade = false
    Config.auto_block = false
    State.authRevision = State.authRevision + 1
    State.authValidated = false
    State.csrf = nil

    -- Invalidate first, then cancel workers before restoring shared game tables.
    if lifecycle.environment.__MM2BlessingCleanup == lifecycle.cleanup then
        lifecycle.environment.__MM2BlessingCleanup = nil
        lifecycle.environment[GEN_KEY] = (lifecycle.environment[GEN_KEY] or 0) + 1
        lifecycle.environment.VisualTradeActive = false
        lifecycle.environment[PERSIST_KEY] = nil
    end
    for thread in pairs(lifecycle.threads) do
        if thread ~= coroutine.running() then
            pcall(lifecycle.nativeTask.cancel, thread)
        end
    end
    table.clear(lifecycle.threads)
    if lifecycle.fakeLobbyFolder then
        lifecycle.fakeLobbyFolder:Destroy()
        lifecycle.fakeLobbyFolder = nil
    end
    for _, connection in ipairs(externalConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(externalConnections)
    functions.UnConnections()

    removeInvalidWeapons()
    for obj, saved in pairs(savedMetatables) do
        local ok, err = pcall(function()
            local owned = obj.Owned
            if type(owned) == "table" then
                local real = trueValues[saved.itemType] or {}
                for key in pairs(owned) do
                    if real[key] == nil then rawset(owned, key, nil) end
                end
                for key, value in pairs(real) do rawset(owned, key, value) end
            end
            setmetatable(obj, saved.mt)
            rawset(obj, "Owned", owned)
        end)
        if not ok then warn("[VisualTrade] Profile cleanup failed: " .. tostring(err)) end
    end
    for obj, saved in pairs(savedOwnedMetatables) do
        local ok, err = pcall(setmetatable, obj, saved.mt)
        if not ok then warn("[VisualTrade] Inventory cleanup failed: " .. tostring(err)) end
    end
    table.clear(savedMetatables)
    table.clear(savedOwnedMetatables)
    table.clear(spoofed)
    table.clear(scannerBlockedUsers)
    if wasVisualTrade then
        pcall(function()
            TradeGUI.Enabled = false
            YourOffer.Accepted.Visible = false
            TheirOffer.Accepted.Visible = false
            TradeGUI.Container.Trade.Actions.Accept.Cooldown.Visible = false
        end)
    end
    pcall(function() game.ReplicatedStorage.Remotes.Inventory.InventoryDataChanged:Fire() end)
    TradeInventory = nil
    State.cookie = ""
    State.browserTrackerId = nil
    if controlGui then
        local oldGui = controlGui
        controlGui = nil
        if not fromDestroy then oldGui:Destroy() end
    end
end
lifecycle.environment.__MM2BlessingCleanup = lifecycle.cleanup
