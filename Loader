    local thread = coroutine.create(function()
        if not isStale() then
            local ok, err = xpcall(function()
                callback(table.unpack(args, 1, args.n))
            end, debug.traceback)
            lifecycle.threads[coroutine.running()] = nil
            if not ok then error(err, 0) end
        else
            lifecycle.threads[coroutine.running()] = nil
        end
    end)
    lifecycle.threads[thread] = true
    if kind == "delay" then
        lifecycle.nativeTask.delay(delaySeconds, thread)
    else
        lifecycle.nativeTask[kind](thread)
    end
    return thread
end
